# caffeinated-clients configuration
# Copy to .env for local development, or set these in Coolify.
# Never commit a real key or password.

# Public URL of the app (use https in production). Drives secure-cookie
# flags, the PWA manifest, and the TOTP issuer.
CCLIENTS_BASE_URL=http://localhost:8080

# Required. Base64-encoded 32-byte key for the encrypted SQLite database.
# Generate with: head -c 32 /dev/urandom | base64
# Losing this key means permanent loss of all data.
CCLIENTS_DB_KEY=

# Where the encrypted database lives.
CCLIENTS_DATA_DIR=./data
CCLIENTS_DB_PATH=

# Bind address and session lifetime.
CCLIENTS_LISTEN_ADDR=:8080
CCLIENTS_SESSION_TTL=720h

# Set true when running behind Coolify/a reverse proxy so client IPs
# (used for login rate limiting) are read from X-Forwarded-*.
CCLIENTS_TRUST_PROXY=false

# debug | info | warn | error
CCLIENTS_LOG_LEVEL=info

# First-run only: creates the single user. Remove after TOTP enrollment.
CCLIENTS_BOOTSTRAP_USERNAME=
CCLIENTS_BOOTSTRAP_PASSWORD=

# Break-glass only: disables the TOTP step (the password is still
# required). Logs a loud warning. Intended only to recover a lost
# authenticator.
CCLIENTS_DISABLE_2FA=false
